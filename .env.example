APP_NAME="Velvet Onboarding"
VELVET_ADMIN_NAME="Velvet Admin"
VELVET_ADMIN_EMAIL=admin@velvet.local
VELVET_ADMIN_PASSWORD=change-me-now
# Se usa únicamente al ejecutar: php artisan db:seed --class=TestUsersSeeder
VELVET_TEST_USERS_PASSWORD=ChangeMe123!
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Bogota
# Agent OAuth: códigos de autorización de corta duración y tokens rotables.
AGENT_OAUTH_CODE_MINUTES=2
AGENT_OAUTH_ACCESS_MINUTES=60
AGENT_OAUTH_REFRESH_DAYS=30
# ProducciÃ³n: APP_DEBUG=false, HTTPS y la lista exacta de proxies de confianza.
TRUSTED_PROXIES=127.0.0.1

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Identity verification (Didit)
DIDIT_BASE_URL=https://verification.didit.me
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
DIDIT_WEBHOOK_URL=${APP_URL}/webhooks/didit
DIDIT_EVIDENCE_DISK=local

# WhatsApp del equipo para solicitudes de reprogramación
VELVET_WHATSAPP_NUMBER=
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
ABLY_API_KEY=
ABLY_CHANNEL=admin-leads
ABLY_STATION_MANAGER_CHANNEL=admin-station-manager
VITE_GOOGLE_ANALYTICS_ID=
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_META_PIXEL_ID=1117902760979898

# VELVET Agent (HTTPS required; explicit external studio registry)
AGENT_MASTER_URL=https://master.example.com/
AGENT_STUDIO_IDS=
